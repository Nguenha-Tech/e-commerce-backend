# ---------------------------------------------------------------- app
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
API_URL=http://localhost:3333
FRONTEND_URL=http://localhost:5173
# Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Swagger em /docs (por omissão: ativo fora de produção)
# DOCS_ENABLED=true

# ---------------------------------------------------------------- base de dados
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopping?schema=public

# ---------------------------------------------------------------- autenticação
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
COOKIE_SECRET=change-me-to-another-long-random-secret-32-chars
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN=.minhaloja.co.mz
# COOKIE_SECURE=true            # por omissão: true em produção
# lax | strict | none (none exige HTTPS; usar se frontend e API estiverem em domínios diferentes)
COOKIE_SAMESITE=lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------- uploads / storage
# local | cloudinary
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_PUBLIC_URL=http://localhost:3333/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=electro-shop
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_MAX_FILES=10

# ---------------------------------------------------------------- email
EMAIL_PROVIDER=console
EMAIL_FROM="Electro Shop <no-reply@electroshop.local>"

# ---------------------------------------------------------------- regras comerciais
DEFAULT_CURRENCY=MZN
STORE_TIMEZONE=Africa/Maputo
TAX_RATE_PERCENT=16
TAX_INCLUDED_IN_PRICES=true
CART_MAX_QTY_PER_ITEM=20
CART_GUEST_TTL_DAYS=30
STOCK_RESERVATION_TTL_MINUTES=30

# ---------------------------------------------------------------- pagamentos
# Segredo HMAC do gateway simulado (dev/testes). Gateways reais terão as suas variáveis.
PAYMENT_MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret-change-me

# ---------------------------------------------------------------- jobs
JOBS_ENABLED=true

# ---------------------------------------------------------------- seed (conta OWNER inicial)
OWNER_NAME=Store Owner
OWNER_EMAIL=owner@shopping.local
OWNER_PASSWORD=ChangeMe-Owner-2026
