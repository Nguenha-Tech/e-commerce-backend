// =============================================================================
// Electro Shop — modelo de dados
// Convenções:
//  - IDs UUID; tabelas em snake_case (@@map); colunas em camelCase.
//  - Valores monetários em INTEIROS na unidade mínima da moeda (centavos).
//    Ex.: 75.000,00 MZN => 7500000. Evita erros de vírgula flutuante.
//  - Soft delete via `deletedAt` nas entidades importantes.
//  - Pedidos guardam snapshots (nome, SKU, preço, endereço...) e nunca
//    dependem dos dados atuais do produto.
// =============================================================================

// Prisma 7: cliente TypeScript gerado (sem binários Rust), ligado ao PostgreSQL
// pelo driver adapter `@prisma/adapter-pg`. A URL vem de prisma.config.ts.
generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  BLOCKED
  DISABLED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  INACTIVE
  DISCONTINUED
}

enum SpecValueType {
  TEXT
  NUMBER
  BOOLEAN
  OPTION
}

enum ProductRelationType {
  SIMILAR
  RECOMMENDED
  ACCESSORY
  FREQUENTLY_BOUGHT_TOGETHER
}

enum InventoryMovementType {
  INITIAL
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGED
  RETURN
  CANCELLATION_RESTOCK
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethodType {
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  CASH_ON_DELIVERY
  OTHER
}

enum PaymentTransactionType {
  INITIATION
  PAYMENT
  FAILURE
  REFUND
  WEBHOOK
  MANUAL_CONFIRMATION
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ShippingMethodType {
  STANDARD
  EXPRESS
  PICKUP
}

enum ShipmentStatus {
  PENDING
  READY
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum PromotionScope {
  STOREWIDE
  PRODUCT
  CATEGORY
  BRAND
}

enum PromotionKind {
  REGULAR
  FLASH_SALE
  SEASONAL
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
  REJECTED
}

enum QuestionStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum NotificationType {
  ORDER_CREATED
  PAYMENT_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PROMOTION
  BACK_IN_STOCK
  COUPON
  PASSWORD_CHANGED
  ACCOUNT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum BannerPlacement {
  HOMEPAGE
  CATEGORY
  PROMOTION
  FLASH_SALE
}

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CANCELLED
}

enum WhatsAppSource {
  HOMEPAGE
  PRODUCT
  CART
  CHECKOUT
  SUPPORT
  CONTACT
}

// ----------------------------------------------------------------------------
// Identidade, autenticação e autorização
// ----------------------------------------------------------------------------

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String     @db.VarChar(120)
  username            String?    @unique @db.VarChar(40)
  email               String     @unique @db.VarChar(254)
  phone               String?    @unique @db.VarChar(20)
  passwordHash        String
  avatarUrl           String?
  country             String?    @db.VarChar(80)
  province            String?    @db.VarChar(80)
  city                String?    @db.VarChar(80)
  birthDate           DateTime?  @db.Date
  status              UserStatus @default(ACTIVE)
  blockedReason       String?
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  roles               UserRole[]          @relation("UserRoles")
  rolesAssigned       UserRole[]          @relation("RoleAssigner")
  sessions            Session[]
  tokens              VerificationToken[]
  addresses           Address[]
  cart                Cart?
  wishlist            Wishlist?
  orders              Order[]
  reviews             Review[]
  reviewReports       ReviewReport[]
  questions           ProductQuestion[]   @relation("QuestionAuthor")
  notifications       Notification[]
  couponUsages        CouponUsage[]
  returnRequests      ReturnRequest[]
  stockAlerts         StockAlert[]
  auditLogs           AuditLog[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(50)
  description String?
  /// Hierarquia: quem tem nível inferior nunca gere quem tem nível igual/superior.
  level       Int              @default(0)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(80)
  description String?
  group       String           @db.VarChar(40)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String   @db.Uuid
  roleId       String   @db.Uuid
  assignedById String?  @db.Uuid
  assignedAt   DateTime @default(now())
  user         User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?    @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Sessão = família de refresh tokens com rotação e deteção de reutilização.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  refreshTokenHash  String    @unique
  previousTokenHash String?   @unique
  userAgent         String?   @db.VarChar(500)
  ip                String?   @db.VarChar(64)
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?   @db.VarChar(60)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model Address {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  label         String?     @db.VarChar(60)
  type          AddressType @default(HOME)
  recipientName String      @db.VarChar(120)
  phone         String      @db.VarChar(20)
  country       String      @db.VarChar(80)
  province      String      @db.VarChar(80)
  city          String      @db.VarChar(80)
  neighborhood  String?     @db.VarChar(120)
  street        String      @db.VarChar(200)
  number        String?     @db.VarChar(20)
  reference     String?     @db.VarChar(300)
  postalCode    String?     @db.VarChar(20)
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ----------------------------------------------------------------------------
// Catálogo
// ----------------------------------------------------------------------------

model Category {
  id              String                  @id @default(uuid()) @db.Uuid
  name            String                  @db.VarChar(120)
  slug            String                  @unique @db.VarChar(140)
  description     String?
  imageUrl        String?
  parentId        String?                 @db.Uuid
  status          RecordStatus            @default(ACTIVE)
  sortOrder       Int                     @default(0)
  metaTitle       String?                 @db.VarChar(70)
  metaDescription String?                 @db.VarChar(170)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?
  parent          Category?               @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]              @relation("CategoryTree")
  products        Product[]
  specTemplates   SpecificationTemplate[]
  banners         Banner[]

  @@index([parentId])
  @@index([status, deletedAt])
  @@map("categories")
}

model Brand {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(80)
  slug        String       @unique @db.VarChar(100)
  logoUrl     String?
  description String?
  website     String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  products    Product[]

  @@map("brands")
}

model Tag {
  id       String       @id @default(uuid()) @db.Uuid
  name     String       @unique @db.VarChar(60)
  slug     String       @unique @db.VarChar(80)
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String  @db.Uuid
  tagId     String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

model Product {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String        @db.VarChar(200)
  slug               String        @unique @db.VarChar(220)
  sku                String        @unique @db.VarChar(64)
  internalCode       String?       @db.VarChar(64)
  shortDescription   String?       @db.VarChar(500)
  description        String?
  brandId            String?       @db.Uuid
  categoryId         String        @db.Uuid
  status             ProductStatus @default(DRAFT)
  isFeatured         Boolean       @default(false)
  isNew              Boolean       @default(false)
  isRecommended      Boolean       @default(false)
  currency           String        @default("MZN") @db.Char(3)

  // Campos desnormalizados (recalculados ao alterar variantes/stock/avaliações)
  // para listagens, filtros e ordenação rápidos.
  minPrice           Int           @default(0)
  maxPrice           Int           @default(0)
  maxDiscountPercent Int           @default(0)
  isOnSale           Boolean       @default(false)
  availableStock     Int           @default(0)
  soldCount          Int           @default(0)
  viewCount          Int           @default(0)
  ratingAvg          Float         @default(0)
  ratingCount        Int           @default(0)

  hasWarranty        Boolean       @default(false)
  warrantyMonths     Int?
  warrantyTerms      String?

  metaTitle          String?       @db.VarChar(70)
  metaDescription    String?       @db.VarChar(170)
  canonicalUrl       String?

  publishedAt        DateTime?
  createdById        String?       @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  brand              Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category           Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants           ProductVariant[]
  images             ProductImage[]
  specifications     ProductSpecification[]
  tags               ProductTag[]
  reviews            Review[]
  questions          ProductQuestion[]
  relatedFrom        ProductRelation[]      @relation("RelationSource")
  relatedTo          ProductRelation[]      @relation("RelationTarget")
  wishlistItems      WishlistItem[]
  orderItems         OrderItem[]
  banners            Banner[]

  @@index([status, deletedAt])
  @@index([categoryId])
  @@index([brandId])
  @@index([minPrice])
  @@index([soldCount])
  @@index([ratingAvg])
  @@index([createdAt])
  @@index([maxDiscountPercent])
  @@map("products")
}

/// Todo o produto tem pelo menos uma variante (a "default" num produto simples).
/// Preço, stock, peso e dimensões vivem aqui.
model ProductVariant {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String    @db.Uuid
  sku              String    @unique @db.VarChar(64)
  name             String?   @db.VarChar(120)
  /// Ex.: {"color":"Preto","storage":"256GB"}
  options          Json      @default("{}")
  barcode          String?   @db.VarChar(64)
  originalPrice    Int
  price            Int
  promoPrice       Int?
  promoStartsAt    DateTime?
  promoEndsAt      DateTime?
  costPrice        Int?
  weightGrams      Int?
  heightMm         Int?
  widthMm          Int?
  lengthMm         Int?
  packageWeightGrams Int?
  packageHeightMm  Int?
  packageWidthMm   Int?
  packageLengthMm  Int?
  isDefault        Boolean   @default(false)
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory        Inventory?
  images           ProductImage[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reservations     StockReservation[]
  stockAlerts      StockAlert[]

  @@index([productId])
  @@index([options(ops: JsonbPathOps)], type: Gin)
  @@map("product_variants")
}

model ProductImage {
  id              String          @id @default(uuid()) @db.Uuid
  productId       String          @db.Uuid
  variantId       String?         @db.Uuid
  url             String
  thumbnailUrl    String?
  storageKey      String
  thumbnailKey    String?
  storageProvider String          @db.VarChar(30)
  altText         String?         @db.VarChar(200)
  sortOrder       Int             @default(0)
  isMain          Boolean         @default(false)
  width           Int?
  height          Int?
  sizeBytes       Int?
  mimeType        String?         @db.VarChar(40)
  createdAt       DateTime        @default(now())
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// Especificações flexíveis chave/valor (sem colunas rígidas por categoria).
model ProductSpecification {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @db.Uuid
  group        String? @db.VarChar(60)
  key          String  @db.VarChar(80)
  value        String  @db.VarChar(300)
  unit         String? @db.VarChar(20)
  numericValue Float?
  isFilterable Boolean @default(true)
  sortOrder    Int     @default(0)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([key, value])
  @@map("product_specifications")
}

/// Modelo opcional de especificações sugeridas por categoria (guia o painel admin).
model SpecificationTemplate {
  id           String        @id @default(uuid()) @db.Uuid
  categoryId   String        @db.Uuid
  key          String        @db.VarChar(80)
  label        String        @db.VarChar(80)
  group        String?       @db.VarChar(60)
  unit         String?       @db.VarChar(20)
  valueType    SpecValueType @default(TEXT)
  options      Json?
  isRequired   Boolean       @default(false)
  isFilterable Boolean       @default(true)
  sortOrder    Int           @default(0)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@map("specification_templates")
}

model ProductRelation {
  id               String              @id @default(uuid()) @db.Uuid
  productId        String              @db.Uuid
  relatedProductId String              @db.Uuid
  type             ProductRelationType
  sortOrder        Int                 @default(0)
  product          Product             @relation("RelationSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product             @relation("RelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId, type])
  @@map("product_relations")
}

// ----------------------------------------------------------------------------
// Inventário
// ----------------------------------------------------------------------------

/// available = quantity - reserved (sempre calculado, nunca guardado).
model Inventory {
  id        String              @id @default(uuid()) @db.Uuid
  variantId String              @unique @db.Uuid
  quantity  Int                 @default(0)
  reserved  Int                 @default(0)
  minStock  Int                 @default(0)
  maxStock  Int?
  location  String?             @db.VarChar(80)
  updatedAt DateTime            @updatedAt
  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@map("inventory")
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  inventoryId    String                @db.Uuid
  type           InventoryMovementType
  /// Com sinal: +20 entrada, -2 saída.
  quantity       Int
  quantityBefore Int
  quantityAfter  Int
  reason         String?               @db.VarChar(300)
  referenceType  String?               @db.VarChar(40)
  referenceId    String?               @db.Uuid
  createdById    String?               @db.Uuid
  createdAt      DateTime              @default(now())
  inventory      Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model StockReservation {
  id        String            @id @default(uuid()) @db.Uuid
  variantId String            @db.Uuid
  orderId   String            @db.Uuid
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([orderId])
  @@map("stock_reservations")
}

/// "Avise-me quando voltar ao stock".
model StockAlert {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  variantId  String         @db.Uuid
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@map("stock_alerts")
}

// ----------------------------------------------------------------------------
// Carrinho e favoritos
// ----------------------------------------------------------------------------

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String?    @unique @db.Uuid
  /// Hash SHA-256 do token do carrinho de visitante (cookie).
  guestTokenHash String?    @unique
  couponCode     String?    @db.VarChar(40)
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @unique @db.Uuid
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  variantId  String?  @db.Uuid
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ----------------------------------------------------------------------------
// Pedidos
// ----------------------------------------------------------------------------

model Order {
  id                 String            @id @default(uuid()) @db.Uuid
  orderNumber        String            @unique @db.VarChar(30)
  userId             String            @db.Uuid
  status             OrderStatus       @default(PENDING)
  paymentStatus      PaymentStatus     @default(PENDING)
  currency           String            @db.Char(3)

  subtotal           Int
  productDiscount    Int               @default(0)
  couponDiscount     Int               @default(0)
  shippingTotal      Int               @default(0)
  taxTotal           Int               @default(0)
  taxIncluded        Boolean           @default(true)
  grandTotal         Int

  couponId           String?           @db.Uuid
  couponCode         String?           @db.VarChar(40)

  shippingMethodId   String?           @db.Uuid
  shippingMethodCode String            @db.VarChar(40)
  shippingMethodName String            @db.VarChar(120)
  /// Snapshot do endereço no momento da compra.
  shippingAddress    Json?
  paymentMethodCode  String            @db.VarChar(40)
  paymentMethodType  PaymentMethodType

  trackingCode       String?           @db.VarChar(80)
  customerNote       String?           @db.VarChar(500)
  adminNote          String?
  requiresAttention  Boolean           @default(false)
  cancelReason       String?           @db.VarChar(300)

  idempotencyKey     String            @db.VarChar(100)
  placedAt           DateTime          @default(now())
  confirmedAt        DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon             Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingMethod     ShippingMethod?      @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  payments           Payment[]
  shipments          Shipment[]
  reservations       StockReservation[]
  returnRequests     ReturnRequest[]
  couponUsage        CouponUsage?

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("orders")
}

/// Snapshot completo do item no momento da compra.
model OrderItem {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @db.Uuid
  productId         String?         @db.Uuid
  variantId         String?         @db.Uuid
  productName       String          @db.VarChar(200)
  productSlug       String          @db.VarChar(220)
  sku               String          @db.VarChar(64)
  variantName       String?         @db.VarChar(120)
  variantOptions    Json            @default("{}")
  imageUrl          String?
  categoryId        String?         @db.Uuid
  brandName         String?         @db.VarChar(80)
  originalUnitPrice Int
  unitPrice         Int
  costPrice         Int?
  quantity          Int
  couponDiscount    Int             @default(0)
  taxTotal          Int             @default(0)
  lineTotal         Int
  createdAt         DateTime        @default(now())
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  review            Review?
  returnItems       ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?      @db.VarChar(500)
  changedById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ----------------------------------------------------------------------------
// Pagamentos
// ----------------------------------------------------------------------------

/// Métodos de pagamento configuráveis pelo OWNER. Nunca guardar segredos aqui.
model PaymentMethod {
  id           String            @id @default(uuid()) @db.Uuid
  code         String            @unique @db.VarChar(40)
  name         String            @db.VarChar(80)
  type         PaymentMethodType
  /// Código do provider na camada de abstração (cod, manual, mock, mpesa, stripe...)
  provider     String            @db.VarChar(40)
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  instructions String?
  /// Configuração NÃO sensível (ex.: dados bancários públicos para transferência).
  config       Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  payments     Payment[]

  @@map("payment_methods")
}

model Payment {
  id                String               @id @default(uuid()) @db.Uuid
  orderId           String               @db.Uuid
  paymentMethodId   String?              @db.Uuid
  methodCode        String               @db.VarChar(40)
  provider          String               @db.VarChar(40)
  amount            Int
  currency          String               @db.Char(3)
  status            PaymentStatus        @default(PENDING)
  providerReference String?              @db.VarChar(120)
  idempotencyKey    String               @unique @db.VarChar(120)
  refundedAmount    Int                  @default(0)
  paidAt            DateTime?
  failedAt          DateTime?
  failureReason     String?              @db.VarChar(300)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentMethod     PaymentMethod?       @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  transactions      PaymentTransaction[]
  refunds           Refund[]

  @@unique([provider, providerReference])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

model PaymentTransaction {
  id                    String                 @id @default(uuid()) @db.Uuid
  paymentId             String                 @db.Uuid
  type                  PaymentTransactionType
  status                PaymentStatus
  amount                Int
  providerTransactionId String?                @db.VarChar(120)
  /// Resposta do provider SEM dados sensíveis (nº de cartão, etc.).
  rawResponse           Json?
  createdById           String?                @db.Uuid
  createdAt             DateTime               @default(now())
  payment               Payment                @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_transactions")
}

/// Registo de webhooks recebidos; unique(provider,eventId) garante idempotência.
model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String    @db.VarChar(40)
  eventId        String    @db.VarChar(120)
  eventType      String    @db.VarChar(80)
  payload        Json
  processedAt    DateTime?
  error          String?
  receivedAt     DateTime  @default(now())

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model Refund {
  id                String         @id @default(uuid()) @db.Uuid
  paymentId         String         @db.Uuid
  returnRequestId   String?        @db.Uuid
  amount            Int
  reason            String?        @db.VarChar(300)
  status            RefundStatus   @default(PENDING)
  providerReference String?        @db.VarChar(120)
  idempotencyKey    String         @unique @db.VarChar(120)
  createdById       String?        @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  payment           Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnRequest     ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@map("refunds")
}

// ----------------------------------------------------------------------------
// Entregas
// ----------------------------------------------------------------------------

model ShippingMethod {
  id                    String             @id @default(uuid()) @db.Uuid
  code                  String             @unique @db.VarChar(40)
  name                  String             @db.VarChar(120)
  description           String?
  type                  ShippingMethodType
  carrier               String?            @db.VarChar(80)
  basePrice             Int                @default(0)
  /// Preço por kg adicional acima do primeiro kg.
  pricePerKg            Int                @default(0)
  freeShippingThreshold Int?
  estimatedDaysMin      Int                @default(1)
  estimatedDaysMax      Int                @default(3)
  isActive              Boolean            @default(true)
  sortOrder             Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  rates                 ShippingRate[]
  shipments             Shipment[]
  orders                Order[]

  @@map("shipping_methods")
}

/// Preço por região (tabela `shipping` do enunciado). A regra mais específica ganha.
model ShippingRate {
  id               String         @id @default(uuid()) @db.Uuid
  methodId         String         @db.Uuid
  country          String         @db.VarChar(80)
  province         String?        @db.VarChar(80)
  city             String?        @db.VarChar(80)
  price            Int
  estimatedDaysMin Int?
  estimatedDaysMax Int?
  isActive         Boolean        @default(true)
  method           ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  @@index([methodId, country, province, city])
  @@map("shipping_rates")
}

model Shipment {
  id             String          @id @default(uuid()) @db.Uuid
  orderId        String          @db.Uuid
  methodId       String?         @db.Uuid
  carrier        String?         @db.VarChar(80)
  trackingCode   String?         @db.VarChar(80)
  trackingUrl    String?
  status         ShipmentStatus  @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method         ShippingMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  events         TrackingEvent[]

  @@index([orderId])
  @@index([trackingCode])
  @@map("shipments")
}

model TrackingEvent {
  id          String         @id @default(uuid()) @db.Uuid
  shipmentId  String         @db.Uuid
  status      ShipmentStatus
  description String         @db.VarChar(300)
  location    String?        @db.VarChar(120)
  occurredAt  DateTime
  createdAt   DateTime       @default(now())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("tracking_events")
}

// ----------------------------------------------------------------------------
// Cupões e promoções
// ----------------------------------------------------------------------------

model Coupon {
  id                    String        @id @default(uuid()) @db.Uuid
  code                  String        @unique @db.VarChar(40)
  description           String?
  discountType          DiscountType
  /// PERCENTAGE: 1..100 ; FIXED_AMOUNT: valor em centavos ; FREE_SHIPPING: ignorado
  value                 Int
  maxDiscountAmount     Int?
  minOrderAmount        Int?
  startsAt              DateTime?
  expiresAt             DateTime?
  usageLimit            Int?
  usageLimitPerUser     Int?
  usedCount             Int           @default(0)
  status                RecordStatus  @default(ACTIVE)
  applicableCategoryIds String[]      @db.Uuid
  applicableProductIds  String[]      @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?
  usages                CouponUsage[]
  orders                Order[]

  @@map("coupons")
}

model CouponUsage {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @db.Uuid
  userId         String   @db.Uuid
  orderId        String   @unique @db.Uuid
  discountAmount Int
  createdAt      DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_usages")
}

model Promotion {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(120)
  slug        String         @unique @db.VarChar(140)
  description String?
  kind        PromotionKind  @default(REGULAR)
  scope       PromotionScope
  discountType DiscountType
  value       Int
  productIds  String[]       @db.Uuid
  categoryIds String[]       @db.Uuid
  brandIds    String[]       @db.Uuid
  startsAt    DateTime
  endsAt      DateTime
  priority    Int            @default(0)
  isActive    Boolean        @default(true)
  imageUrl    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

// ----------------------------------------------------------------------------
// Avaliações e perguntas
// ----------------------------------------------------------------------------

model Review {
  id                 String         @id @default(uuid()) @db.Uuid
  productId          String         @db.Uuid
  userId             String         @db.Uuid
  orderItemId        String         @unique @db.Uuid
  rating             Int
  title              String?        @db.VarChar(120)
  comment            String?
  status             ReviewStatus   @default(PENDING)
  adminReply         String?
  adminReplyAt       DateTime?
  repliedById        String?        @db.Uuid
  reportCount        Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  product            Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem          OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  images             ReviewImage[]
  reports            ReviewReport[]

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@map("reviews")
}

model ReviewImage {
  id         String @id @default(uuid()) @db.Uuid
  reviewId   String @db.Uuid
  url        String
  storageKey String
  sortOrder  Int    @default(0)
  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_images")
}

model ReviewReport {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @db.Uuid
  userId    String   @db.Uuid
  reason    String   @db.VarChar(300)
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_reports")
}

model ProductQuestion {
  id           String         @id @default(uuid()) @db.Uuid
  productId    String         @db.Uuid
  userId       String         @db.Uuid
  question     String         @db.VarChar(1000)
  answer       String?
  answeredById String?        @db.Uuid
  answeredAt   DateTime?
  status       QuestionStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User           @relation("QuestionAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@map("product_questions")
}

// ----------------------------------------------------------------------------
// Notificações, banners, devoluções, auditoria, configurações
// ----------------------------------------------------------------------------

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String              @db.VarChar(160)
  body      String
  data      Json?
  status    NotificationStatus  @default(PENDING)
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([status, createdAt])
  @@map("notifications")
}

model Banner {
  id             String          @id @default(uuid()) @db.Uuid
  title          String          @db.VarChar(120)
  subtitle       String?         @db.VarChar(200)
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  productId      String?         @db.Uuid
  categoryId     String?         @db.Uuid
  placement      BannerPlacement @default(HOMEPAGE)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([placement, isActive, sortOrder])
  @@map("banners")
}

model ReturnRequest {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  userId          String       @db.Uuid
  status          ReturnStatus @default(REQUESTED)
  reason          String       @db.VarChar(80)
  description     String?
  evidenceUrls    String[]
  reviewedById    String?      @db.Uuid
  reviewedAt      DateTime?
  rejectionReason String?      @db.VarChar(300)
  pickupAt        DateTime?
  receivedAt      DateTime?
  refundAmount    Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           ReturnItem[]
  refunds         Refund[]

  @@index([status, createdAt])
  @@map("return_requests")
}

model ReturnItem {
  id              String        @id @default(uuid()) @db.Uuid
  returnRequestId String        @db.Uuid
  orderItemId     String        @db.Uuid
  quantity        Int
  condition       String?       @db.VarChar(80)
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@map("return_items")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  actorEmail   String?  @db.VarChar(254)
  action       String   @db.VarChar(80)
  resourceType String   @db.VarChar(60)
  resourceId   String?  @db.VarChar(64)
  before       Json?
  after        Json?
  ip           String?  @db.VarChar(64)
  userAgent    String?  @db.VarChar(500)
  requestId    String?  @db.VarChar(64)
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Regras comerciais e configurações da loja (taxa de IVA, limites, etc.).
model StoreSetting {
  key         String   @id @db.VarChar(80)
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  @@map("store_settings")
}

/// WhatsAppConfiguration — o número nunca fica hardcoded no frontend.
model WhatsAppConfig {
  id                 String   @id @default(uuid()) @db.Uuid
  isEnabled          Boolean  @default(false)
  countryCode        String   @default("258") @db.VarChar(4)
  phoneNumber        String   @db.VarChar(15)
  alternativeNumbers Json     @default("[]")
  defaultMessage     String   @db.VarChar(500)
  welcomeMessage     String?  @db.VarChar(500)
  awayMessage        String?  @db.VarChar(500)
  /// Ex.: {"timezone":"Africa/Maputo","days":{"mon":["08:00","18:00"]}}
  businessHours      Json     @default("{}")
  /// Mensagens por contexto: {"HOMEPAGE":"...","PRODUCT":"...","CART":"..."}
  contextMessages    Json     @default("{}")
  buttonText         String   @default("Falar pelo WhatsApp") @db.VarChar(60)
  buttonPosition     String   @default("bottom-right") @db.VarChar(20)
  /// "wa_me" hoje; "business_api" no futuro (credenciais só em env/secret manager).
  provider           String   @default("wa_me") @db.VarChar(20)
  updatedById        String?  @db.Uuid
  updatedAt          DateTime @updatedAt

  @@map("whatsapp_configs")
}

/// WhatsAppAnalytics — só metadados do clique, nunca o conteúdo das conversas.
model WhatsAppClickEvent {
  id          String         @id @default(uuid()) @db.Uuid
  source      WhatsAppSource
  productId   String?        @db.Uuid
  variantId   String?        @db.Uuid
  userId      String?        @db.Uuid
  visitorHash String?        @db.VarChar(64)
  createdAt   DateTime       @default(now())

  @@index([source, createdAt])
  @@index([productId, createdAt])
  @@map("whatsapp_click_events")
}
